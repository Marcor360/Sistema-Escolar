{
  "name": "escolar-web",
  "version": "1.35.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"test/setup.ts\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run --maxWorkers=1",
    "test:responsive": "node test/responsive.cjs",
    "test:cartera": "node test/cartera-integral.cjs",
    "test:boletas": "node test/boletas-seguimiento.cjs",
    "pretest": "node ../scripts/check-glob-dependencies.cjs web"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.2",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "4.14.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.4.5",
    "vitest": "^4.1.12",
    "minimatch-legacy3": "file:vendor/minimatch-3.1.5-escolar.0.tgz",
    "glob-legacy7": "file:vendor/glob-7.2.3-escolar.0.tgz"
  },
  "overrides": {
    "follow-redirects": "1.16.2",
    "minimatch@>=9": "11.0.3",
    "glob@>=9": "14.0.3",
    "minimatch@3": "$minimatch-legacy3",
    "glob@7": "$glob-legacy7"
  }
}
