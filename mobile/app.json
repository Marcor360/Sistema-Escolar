{
  "expo": {
    "name": "Sistema Escolar Portal Alumno",
    "slug": "sistema-escolar",
    "version": "1.34.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "mx.escuela.alumnos"
    },
    "android": {
      "package": "mx.escuela.alumnos"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Permitir usar Face ID para proteger el acceso a la cuenta escolar."
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14343B",
          "android": {
            "drawable": {
              "icon": "./assets/splashscreen_logo.xml"
            }
          }
        }
      ],
      "expo-notifications"
    ],
    "web": {
      "bundler": "metro",
      "name": "Sistema Escolar Portal Alumno",
      "shortName": "Alumno",
      "lang": "es"
    }
  }
}
