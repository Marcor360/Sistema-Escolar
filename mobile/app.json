{
  "expo": {
    "name": "Sistema Escolar",
    "slug": "sistema-escolar",
    "version": "1.27.37",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "mx.escuela.alumnos"
    },
    "android": {
      "package": "mx.escuela.alumnos"
    },
    "plugins": [
      "expo-asset",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#14343B",
          "android": {
            "drawable": {
              "icon": "./assets/splashscreen_logo.xml"
            }
          }
        }
      ],
      "expo-notifications"
    ]
  }
}
