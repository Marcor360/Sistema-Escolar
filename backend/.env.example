# ----- Servidor -----
PORT=3000
# El nombre institucional se configura en la pantalla de marca y se comparte con las boletas.

# ----- Base de datos -----
# DB_TYPE: mysql | mssql  (cambiar motor sin tocar código)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=escolar
DB_PASS=escolar123
DB_NAME=escolar
DB_SSL=false
# Ruta a CA personalizada para MySQL remoto si no está en el almacén de confianza del sistema.
DB_SSL_CA_PATH=
# El esquema se gestiona con database/*/migracion_*.sql; DB_SYNC solo para prototipos.
DB_SYNC=false

# SQL Server: DB_TYPE=mssql, DB_PORT=1433, DB_USER=sa, DB_PASS=Escolar123!
# En desarrollo local con el compose self-signed: DB_ENCRYPT=false y DB_TRUST_SERVER_CERTIFICATE=true.
# En producción: TLS habilitado y certificado validado (no confiar en el certificado presentado).
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# ----- Auth -----
JWT_SECRET=cambiar-en-produccion
# Access token: 15 minutos fijos; refresh rotativo: máximo 30 días por sesión.
# El móvil conserva ambos tokens en SecureStore; web usa memoria y cookie HttpOnly.

# ----- Archivos -----
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=5

# ----- Correo (opcional en desarrollo; obligatorio en producción) -----
# En producción y APP_ENV=staging, SMTP por puerto 587 exige STARTTLS con certificado válido.
# Puerto 465 utiliza TLS implícito. No usar certificados autofirmados sin CA confiable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Colegio Demo <no-reply@colegio.mx>"

# ----- Microsoft 365 Graph (solo backend; habilitar después de aplicar migraciones y pruebas) -----
# No agregar Mail.Send global en Entra: usar Application RBAC restringido al buzón remitente.
# Nunca guardar credenciales, claves privadas ni certificados PFX en Git.
# GRAPH_CERTIFICATE_PATH: archivo público .cer (DER) o .pem cargado en Entra.
# GRAPH_PRIVATE_KEY_PATH: clave privada RSA PEM con ACL solo para identidad de la API.
GRAPH_CORREO_HABILITADO=false
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CORREO_REMITENTE=plataforma365@iua.edu.mx
GRAPH_CERTIFICATE_PATH=
GRAPH_PRIVATE_KEY_PATH=

# ----- Openpay (credenciales del cliente; ver contrato, cláusula DÉCIMA) -----
# Producción requiere API https://api.openpay.mx/v1, retorno HTTPS público y
# usuario/contraseña Basic para el webhook. Sandbox solo en desarrollo/pruebas.
OPENPAY_MERCHANT_ID=
OPENPAY_PRIVATE_KEY=
OPENPAY_BASE_URL=https://sandbox-api.openpay.mx/v1
OPENPAY_REDIRECT_URL=http://localhost:5173/pago-completado

# ----- Seed -----
ALLOW_DEV_SEED=false
SEED_ADMIN_EMAIL=admin@escuela.mx
# Solo para datos demo locales: define cinco contraseñas únicas de 16+ caracteres.
# npm run seed las establece en las cuentas demo cada vez que se ejecuta.
SEED_ADMIN_PASSWORD=
SEED_COORDINACION_PASSWORD=
SEED_DOCENTE_PASSWORD=
SEED_ALUMNO1_PASSWORD=
SEED_ALUMNO2_PASSWORD=

# ----- Seguridad -----
# Producción: NODE_ENV=production desactiva Swagger y exige JWT_SECRET real
NODE_ENV=development
# Orígenes permitidos para CORS, separados por coma (vacío = http://localhost:5173 en desarrollo)
CORS_ORIGINS=
# Ejemplo producción:
# CORS_ORIGINS=https://portal.colegio.mx,https://app.colegio.mx
# Si configuras usuario/contraseña del webhook en el dashboard de Openpay, decláralos aquí
OPENPAY_WEBHOOK_USER=
OPENPAY_WEBHOOK_PASS=

# Push: habilitar solo después de configurar credenciales FCM/APNs de EAS y probar build física.
PUSH_ENABLED=false
# Token opcional del proveedor, privado del backend; nunca EXPO_PUBLIC.
EXPO_ACCESS_TOKEN=

# Biblioteca privada: cuota por plantel; clamdscan debe estar instalado y operativo.
BIBLIOTECA_CUOTA_MB=100

# Outbox de activación/recuperación: obligatorio al configurar SMTP_HOST.
# Generar una clave aleatoria independiente de JWT_SECRET: 32 bytes hex (no usar ejemplos).
# JSON privado: {"identificador":"64-caracteres-hex-aleatorios"}; jamás versionar valores reales.
AUTH_OUTBOX_KEYS=
AUTH_OUTBOX_ACTIVE_KEY=
# Conservar claves antiguas hasta que no haya trabajos vigentes asociados.
AUTH_OUTBOX_RETENTION_DAYS=30
AUTH_OUTBOX_WORKER=true

# Mantener false hasta aprobar y probar inscripción exclusivamente desde cartera.
INSCRIPCION_ORDINARIA_SOLO_CARTERA=false

# Aceptación institucional: activar solo con documentos jurídicamente aprobados y URLs oficiales.
CONSENTIMIENTO_INSTITUCIONAL_HABILITADO=false
REGLAMENTO_ACADEMICO_URL=
REGLAMENTO_ACADEMICO_VERSION=
POLITICAS_INSTITUCIONALES_URL=
POLITICAS_INSTITUCIONALES_VERSION=

# Automatización financiera (deshabilitada hasta aprobar vencimientos y SMTP en UAT).
# Actor REAL de rol FINANZAS activo con planteles asignados; se verifica en cada ejecución.
FINANZAS_AUTO_ACTOR_ID=
# Día 3 local (America/Mexico_City): solo cargos realmente vencidos de sus planteles.
COBRANZA_DIA3_HABILITADA=false
# Desde día 4: 10% solo en cargos con fecha vencida y concepto habilitado; no duplica recargo.
# La colegiatura generada actualmente vence día 5 por defecto; no se recarga antes de vencer.
RECARGOS_AUTOMATICOS_HABILITADOS=false
