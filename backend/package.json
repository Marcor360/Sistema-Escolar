{
  "name": "escolar-backend",
  "version": "1.16.1",
  "description": "API del Sistema Escolar Multiplataforma (MVP) — NestJS + TypeORM (MySQL / SQL Server)",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "dev": "nest start --watch",
    "db:migrate": "node dist/database/migrate.js up",
    "db:migrate:status": "node dist/database/migrate.js status",
    "db:migrate:adopt": "node dist/database/migrate.js adopt",
    "seed": "ts-node -r tsconfig-paths/register src/seed/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "pretest": "node scripts/verificar-sprintf.cjs",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.cjs --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.3",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "helmet": "^8.2.0",
    "mssql": "^11.0.1",
    "multer": "^2.4.0",
    "mysql2": "^3.11.5",
    "nodemailer": "^10.0.13",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.15.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sprintf-js": "file:vendor/sprintf-js-1.1.4-escolar.0.tgz",
    "typeorm": "^0.3.20",
    "typeorm-naming-strategies": "^4.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.17.10",
    "@types/nodemailer": "^6.4.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.13.8",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^8.57.1",
    "jest": "^30.5.2",
    "prettier": "^3.3.3",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "4.3.2"
    },
    "exceljs": {
      "uuid": "11.1.1"
    },
    "js-yaml": "4.3.2",
    "sprintf-js": "$sprintf-js"
  }
}
