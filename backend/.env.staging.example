# Plantilla para Windows Server 2019. Copiar fuera del repositorio como .env y completar.
NODE_ENV=production
APP_ENV=staging
PORT=3000
HOST=127.0.0.1
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=escolar_staging
DB_USER=escolar_staging_app
DB_PASS=REEMPLAZAR_CON_SECRETO
DB_SSL=true
DB_SSL_CA_PATH=
# El respaldo usa credenciales separadas en C:\SistemaEscolar\config\backup.env.
DB_SYNC=false
JWT_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO_EXCLUSIVO_DE_STAGING
CORS_ORIGINS=https://sistema-staging.dominio.mx
UPLOADS_DIR=C:\SistemaEscolar\data\uploads
MAX_UPLOAD_MB=5

# Mantener las integraciones externas en sandbox hasta una habilitación explícita.
OPENPAY_BASE_URL=https://sandbox-api.openpay.mx/v1
OPENPAY_MERCHANT_ID=
OPENPAY_PRIVATE_KEY=
OPENPAY_REDIRECT_URL=https://sistema-staging.dominio.mx/pago-completado
OPENPAY_WEBHOOK_USER=
OPENPAY_WEBHOOK_PASS=

# Correo saliente verificado en cPanel (Connect Devices) para plataforma-stagin@iua.edu.mx.
# TLS implicito puerto 465. Introducir SMTP_PASS solo en el .env privado del VPS.
# Mantener SMTP_REQUIRED=false hasta instalar las credenciales y comprobar entrega.
SMTP_HOST=mail.iua.edu.mx
SMTP_PORT=465
# Al activar SMTP, configurar SMTP_USER=plataforma-stagin@iua.edu.mx y SMTP_PASS juntos en el .env privado.
SMTP_USER=
SMTP_PASS=
SMTP_FROM="IUA Plataforma Staging <plataforma-stagin@iua.edu.mx>"
SMTP_REQUIRED=false

# Microsoft 365 Graph: configuración privada exclusivamente en backend.
# Activar tras validar certificado, ACL, Exchange RBAC y entrega real a destinatarios de prueba.
GRAPH_CORREO_HABILITADO=false
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CORREO_REMITENTE=plataforma365@iua.edu.mx
GRAPH_CERTIFICATE_PATH=
GRAPH_PRIVATE_KEY_PATH=

# Outbox privado de activación y recuperación. Nunca versionar claves reales.
AUTH_OUTBOX_KEYS=
AUTH_OUTBOX_ACTIVE_KEY=
AUTH_OUTBOX_RETENTION_DAYS=30
AUTH_OUTBOX_WORKER=true

# Push: habilitar solo después de configurar credenciales FCM/APNs de EAS y probar build física.
PUSH_ENABLED=false
# Token opcional del proveedor, privado del backend; nunca EXPO_PUBLIC.
EXPO_ACCESS_TOKEN=

# Mantener false hasta aprobar y probar inscripción exclusivamente desde cartera.
INSCRIPCION_ORDINARIA_SOLO_CARTERA=false

# Aceptación institucional: activar solo con documentos jurídicamente aprobados y URLs oficiales.
CONSENTIMIENTO_INSTITUCIONAL_HABILITADO=false
REGLAMENTO_ACADEMICO_URL=
REGLAMENTO_ACADEMICO_VERSION=
POLITICAS_INSTITUCIONALES_URL=
POLITICAS_INSTITUCIONALES_VERSION=

# Estado seguro del respaldo programado; solo SUPERADMIN puede consultarlo.
# BACKUP_STATUS_PATH=C:\SistemaEscolar\logs\backup-status.json
